# ==========================================
# 1. Build Files (Build Artifacts)
# ==========================================
target/
build/
bin/
out/
.gradle/
.gradletasknamecache

# Exceptions to ensure that specific outputs are not ignored when necessary
!**/src/main/**/target/
!**/src/test/**/target/

# ==========================================
# 2. PACKAGES & ARCHIVES
# ==========================================
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# CRUCIAL EXCEPTION: We keep the wrappers for portability
!**/gradle-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar

# ==========================================
# 3. DEVELOPMENT ENVIRONMENTS (IDEs)
# ==========================================

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
cmake-build-*/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ==========================================
